# Copy to .env and fill in. NEVER commit .env, and never put real
# credentials in this example file.
DATABASE_URL=sqlite:///./scraper.db
# MySQL example (note the placeholder — substitute your own):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
ADMIN_API_KEY=replace-me-with-a-long-random-string
APPROVED_PARTICIPANTS_CSV=./approved_participants.csv
# Window (seconds) used when pairing a shared link to a passively
# captured post. See docs/ARCHITECTURE.md.
PAIRING_WINDOW_SECONDS=900
